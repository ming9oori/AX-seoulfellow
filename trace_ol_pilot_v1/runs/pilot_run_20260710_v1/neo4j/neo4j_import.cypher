// TRACE-OL pilot idempotent LOAD CSV package
LOAD CSV WITH HEADERS FROM 'file:///neo4j_documents.csv' AS row MERGE (n:Document {id:row.id}) SET n.name=row.name, n.human_reviewed=false;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_sections.csv' AS row MERGE (n:Section {id:row.id}) SET n.section_no=row.section_no, n.title=row.title WITH n,row MATCH (d:Document {id:row.document_id}) MERGE (d)-[:HAS_SECTION]->(n);
LOAD CSV WITH HEADERS FROM 'file:///neo4j_evidence.csv' AS row MERGE (n:Evidence {id:row.id}) SET n.excel_row=toInteger(row.excel_row), n.page=toInteger(row.page), n.text=row.text, n.split=row.split, n.stratum=row.stratum WITH n,row MATCH (s:Section {id:row.section_id}) MERGE (s)-[:HAS_EVIDENCE]->(n);
LOAD CSV WITH HEADERS FROM 'file:///neo4j_claims.csv' AS row MERGE (n:Claim {id:row.id}) SET n.claim_family=row.claim_family, n.claim_type=row.claim_type, n.modality=row.modality, n.polarity=row.polarity, n.promotion_target=row.promotion_target, n.status=row.status, n.reference_tier=row.reference_tier, n.human_reviewed=false;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_concepts.csv' AS row MERGE (n:Concept {id:row.id}) SET n.pref_label=row.pref_label, n.kernel_type=row.kernel_type, n.human_reviewed=false;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_assertions.csv' AS row MERGE (n:Assertion {id:row.id}) SET n.predicate=row.predicate, n.promotion_target=row.promotion_target, n.status=row.status, n.operational=true;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_rules.csv' AS row MERGE (n:Rule {id:row.id}) SET n.modality=row.modality, n.polarity=row.polarity, n.status=row.status;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_conditions.csv' AS row MERGE (n:Condition {id:row.id}) SET n.text=row.text, n.start=toInteger(row.start), n.end=toInteger(row.end);
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'ASSERTS' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:ASSERTS {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'COMPARES' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:COMPARES {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'DEFINES' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:DEFINES {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'HAS_ARGUMENT' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:HAS_ARGUMENT {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'HAS_CONDITION' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:HAS_CONDITION {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'OBJECT' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:OBJECT {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'PRECEDES' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:PRECEDES {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'PRODUCES' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:PRODUCES {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'PROMOTED_TO' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:PROMOTED_TO {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'SUBJECT' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:SUBJECT {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
LOAD CSV WITH HEADERS FROM 'file:///neo4j_relationships.csv' AS row WITH row WHERE row.type = 'SUPPORTS' MATCH (s {id:row.source_id}), (t {id:row.target_id}) MERGE (s)-[r:SUPPORTS {id:row.id}]->(t) SET r.operational=(row.operational='true'), r.claim_id=row.claim_id, r.evidence_id=row.evidence_id, r.assertion_id=row.assertion_id, r.role=row.role;
