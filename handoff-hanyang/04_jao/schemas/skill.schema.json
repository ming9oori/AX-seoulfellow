{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jao.example.org/schemas/skill.schema.json",
  "title": "Skill (Anthropic-style modular capability)",
  "description": "에이전트가 장착하는 모듈러 지식·역량 패키지. instructionPrompt + 예제 + 도구 트리거로 구성.",
  "type": "object",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "class": { "const": "Skill" },
        "namespace": { "enum": ["jao","agent","ncs","esco"] },
        "instructionPrompt": {
          "type": "string",
          "description": "이 스킬을 적용할 때 LLM에 주입되는 시스템 프롬프트",
          "minLength": 10
        },
        "examples": {
          "type": "array",
          "description": "참조 예제 파일/케이스 URI 또는 짧은 예시",
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "pattern": "^jao://Tool/" }
        },
        "triggers": {
          "type": "array",
          "description": "이 스킬이 활성화되는 트리거 키워드/조건",
          "items": { "type": "string" }
        },
        "requires": {
          "type": "array",
          "description": "선행 Skill 또는 Concept URI",
          "items": { "type": "string", "pattern": "^jao://" }
        },
        "kSAType": {
          "type": "string",
          "enum": ["knowledge","skill","attitude","mixed"],
          "description": "NCS KSA 분류와 호환"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "NCS 수준 1~8 또는 O*NET Level 변환"
        }
      },
      "required": ["instructionPrompt"]
    }
  ]
}
