@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zaije: <https://example.org/zaije/> .

zaije:AssertionShape a sh:NodeShape ;
    sh:targetClass zaije:Assertion ;
    sh:property [ sh:path zaije:evidencedBy ; sh:minCount 1 ] ;
    sh:property [
        sh:path zaije:confidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0
    ] ;
    sh:property [ sh:path zaije:generatedBy ; sh:minCount 1 ] ;
    sh:property [ sh:path zaije:derivedFrom ; sh:minCount 1 ] .

zaije:RuleShape a sh:NodeShape ;
    sh:targetClass zaije:Rule ;
    sh:property [ sh:path zaije:modality ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path zaije:evidencedBy ; sh:minCount 1 ] .

zaije:ConditionalRuleShape a sh:NodeShape ;
    sh:targetClass zaije:ConditionalRule ;
    sh:property [ sh:path zaije:hasCondition ; sh:minCount 1 ] .

zaije:PrecedesShape a sh:NodeShape ;
    sh:targetSubjectsOf zaije:precedes ;
    sh:class zaije:WorkUnit .

zaije:OutputShape a sh:NodeShape ;
    sh:targetObjectsOf zaije:producesOutput ;
    sh:class zaije:InformationObject .
