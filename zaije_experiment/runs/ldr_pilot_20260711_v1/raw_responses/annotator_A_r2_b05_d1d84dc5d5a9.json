          "text": "{\"annotations\":[{\"evidence_id\":\"zaije:evidence/xlsx-row-553\",\"bundle_hash\":\"dc450c2992497a8c93fd52854aed4e46a1b8351392beab9110dc43618677a2cc\",\"annotation_role\":\"DOMAIN_FIRST\",\"claims\":[{\"claim_local_id\":\"1\",\"claim_quote\":\"분석적 평가자는 항목별로 평가한 후 집계하는 반면, 통합적 평가자는 총점(또는 등수)을 먼저 정한 후에 이를 배분한다.\",\"claim_family\":\"DESCRIPTIVE\",\"claim_type\":\"DESCRIPTIVE_FACT\",\"arguments\":[],\"predicate\":\"describes\",\"modality\":\"DESCRIPTIVE\",\"polarity\":\"POSITIVE\",\"condition_quote\":null,\"exception_quote\":null,\"scope_quote\":null,\"discourse_status\":\"GENERAL_RULE\",\"promotion_target\":\"DO_NOT_PROMOTE\",\"uncertain_fields\":[]},{\"claim_local_id\":\"2\",\"claim_quote\":\"통합적 ᆞ 분석적 평가자 분석은 수주영업 단계에서도 활용된다.\",\"claim_family\":\"DESCRIPTIVE\",\"claim_type\":\"DESCRIPTIVE_FACT\",\"arguments\":[],\"predicate\":\"describes\",\"modality\":\"DESCRIPTIVE\",\"polarity\":\"POSITIVE\",\"condition_quote\":null,\"exception_quote\":null,\"scope_quote\":null,\"discourse_status\":\"GENERAL_RULE\",\"promotion_target\":\"DO_NOT_PROMOTE\",\"uncertain_fields\":[]}],\"no_claim_reason\":\"\"},{\"evidence_id\":\"zaije:evidence/xlsx-row-590\",\"bundle_hash\":\"18c57d6b1edffd9777850098ff7ff6e08188c6d5303ad28e21d0d7b48b38baed\",\"annotation_role\":\"DOMAIN_FIRST\",\"claims\":[{\"claim_local_id\":\"1\",\"claim_quote\":\"현실적으로 통합형/분석형 평가자가 섞여 평가위원회가 구성되는 것이 일반적이므로 제안팀을 구성할 때 이를 고려하는 것이 필요하다.\",\"claim_family\":\"NORMATIVE\",\"claim_type\":\"RECOMMENDATION\",\"arguments\":[],\"predicate\":\"recommends\",\"modality\":\"SHOULD\",\"polarity\":\"POSITIVE\",\"condition_quote\":null,\"exception_quote\":null,\"scope_quote\":null,\"discourse_status\":\"GENERAL_GUIDANCE\",\"promotion_target\":\"RULE\",\"uncertain_fields\":[]}],\"no_claim_reason\":\"\"},{\"evidence_id\":\"zaije:evidence/xlsx-row-663\",\"bundle_hash\":\"38b019fa82dba3a3f6691337239778f19ab91f240b5a8baef37be110f256031e\",\"annotation_role\":\"DOMAIN_FIRST\",\"claims\":[{\"claim_local_id\":\"1\",\"claim