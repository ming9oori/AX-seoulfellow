res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-928 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-928_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "다음으로 영향자는 대체로 의사결정에 기능적으로 자기 역할이 있는 내부 영향자(실제 사용자, 재무담당, 구매담당 등)와 외부 영향자(동종업계 의사결정자)로 나눌 수 있다." ;
    eg:excel_row 928 ;
    eg:label "Excel row 928" ;
    eg:page "133.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
