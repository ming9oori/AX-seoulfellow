    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-93" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-930 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-930_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "의사결정자와 영향자를 구분했다면 다음으로는 이들의 이슈가 무엇인지 파악하는 이슈 분석 시트를 사용해야 한다(<예시 1> 참고)." ;
    eg:excel_row 930 ;
    eg:label "Excel row 930" ;
    eg:page "133.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
