res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-236_X05 a eg:ContextSpan ;
    eg:DERIVED_FROM res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-236 ;
