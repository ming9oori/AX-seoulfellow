    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1283_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그런데 대체로 그 업계에서 1위를 하고 있는 회사(A사)는 결코 이를 데이터로 예측하거나 제시하지 않는다." ;
    eg:excel_row 1283 ;
    eg:label "Excel row 1283" ;
    eg:page "169.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
