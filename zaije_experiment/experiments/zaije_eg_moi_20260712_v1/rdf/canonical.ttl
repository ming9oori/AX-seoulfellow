    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "컨설팅 회사를 오랫동안 운영하면서 필자가 깨달은 사실은 우리가 연구하고 개발한 지식의 대부분(쉬플리의 고객과 연관된 정보나 컨설팅 보안이 필요한 일부 지식 제외)은 개방하는 것이 사업에 좋다는 것이다." ;
    eg:excel_row 1246 ;
    eg:label "Excel row 1246" ;
    eg:page "163.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
