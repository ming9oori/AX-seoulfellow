    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "경쟁자를 이기기 위해서는 고객과 경쟁자 정보가 체계적으로 누적되고, 이것이 제안서로 표현되어야 한다." ;
    eg:excel_row 446 ;
