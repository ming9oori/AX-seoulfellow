res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-792 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-792_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "필자는 비로소 그가 왜 최고의 세일즈맨인지 알게 되었다." ;
    eg:excel_row 792 ;
    eg:label "Excel row 792" ;
    eg:page "117.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
