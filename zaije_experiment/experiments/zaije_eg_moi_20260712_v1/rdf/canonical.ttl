    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1316_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "리스크 관리가 중요한 이유는 리스크를 얼마나 잘 이해하고 적절한 대안을 가지고 있는가를 고객에게 보여줌으로써 고객의 신뢰를 확보할 수 있기 때문이다." ;
    eg:excel_row 1316 ;
    eg:label "Excel row 1316" ;
    eg:page "173.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
