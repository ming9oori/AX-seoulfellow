    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "701b1cf90d378dd83ac83a81271d7eb40e739ec87551f89eee024b597ea6a594" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1294" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1295 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1295_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "만약에 이 부분이 고객에게 대단히 중요하고 경쟁사와 비교해 차별화된다면 경쟁에서 이길 수 있다." ;
    eg:excel_row 1295 ;
    eg:label "Excel row 1295" ;
    eg:page "170.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
