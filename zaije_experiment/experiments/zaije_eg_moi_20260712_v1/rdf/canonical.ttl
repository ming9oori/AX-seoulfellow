    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "고객의 소리(VOC)는 구매 의사결정에 참여하는 사람을 설득하는 매우 좋은 방법이다." ;
    eg:excel_row 951 ;
    eg:label "Excel row 951" ;
    eg:page "136.0" ;
