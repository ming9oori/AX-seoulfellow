res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-434 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-434_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
