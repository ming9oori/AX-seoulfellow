    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-44" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-440 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-440_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "성공적인 수주영업을 위해 고객과 경쟁사의 정보를 수집하여 전략 방향을 도출하는 도구를 캡처플랜(Capture Plan)이라 부른다." ;
    eg:excel_row 440 ;
