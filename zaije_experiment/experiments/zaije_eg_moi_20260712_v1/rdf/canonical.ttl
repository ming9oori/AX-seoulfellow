    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그러나 2등 업체는 그런 상황을 따질 겨를이 없다." ;
    eg:excel_row 1285 ;
    eg:label "Excel row 1285" ;
