res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-468 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-468_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-468_A02 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "영업 정보(Capture Plan)는 일반적으로 단일 사업규모가 크고, 그 사업에 대한 정보가 중요한 입찰사업(Bidding Biz)에 적합하고, 고객 정보(Account Plan)는 일상적으로 거래가 발생하는 비입찰 사업(Non-Bidding Biz)에 적합한 도구이다." ;
    eg:excel_row 468 ;
    eg:label "Excel row 468" ;
    eg:page "76.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
