    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "즉, 앞 단계까지가 좌뇌의 영역이었다면 이제 본격적인 전략을 개발하는 이 단계는 우뇌를 사용해서 경쟁자를 이겨야 한다." ;
    eg:excel_row 1077 ;
    eg:label "Excel row 1077" ;
    eg:page "149.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
