    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "2c4b4204b6a039a2ec43a116df961f63f6794d8ee779bdb16aa6520f846073d1" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-437" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-438 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-438_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
