    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1293" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1294 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1294_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "<예시 3>에서는 비용 절감, 국산화 및 수출, 양산화 기간, 자원 재활용을 핵심 승부처로 정하여 공략하고 있다." ;
    eg:excel_row 1294 ;
    eg:label "Excel row 1294" ;
