    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-925" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-926 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-926_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "대형 병원에서 IT 기능을 아웃소싱하려고 할 때 최고경영자의 관심사는 ‘핵심 사업 집중’이나 ‘고객의 안전성’이지만 재무담당 임원의 관심사는 ‘비용’일 것이다." ;
    eg:excel_row 926 ;
    eg:label "Excel row 926" ;
    eg:page "133.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "f81347c645c69aa7d6654ae1b073ab5458cefe46bfb4e8d93a03f01b5a3a8cc1" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-926" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-927 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-927_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "비용에서 큰 차이가 나고, 이 이슈를 재무담당 임원이 계속 강조한다면 비용 격차에 따라 업체가 선정될 것이다." ;
    eg:excel_row 927 ;
    eg:label "Excel row 927" ;
    eg:page "133.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "4e2fc294686997c663c1ab38929c75bd16dd1872290461edd2659c11e033b250" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-927" .

