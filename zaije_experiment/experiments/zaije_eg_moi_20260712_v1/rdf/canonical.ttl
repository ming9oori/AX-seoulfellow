    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그 당시 필자가 몸담았던 영업소는 영업사원이 50명 이상인 큰 지점이었는데 그곳에서 최고의 세일즈맨과 겪었던 일화를 소개한다." ;
    eg:excel_row 772 ;
    eg:label "Excel row 772" ;
