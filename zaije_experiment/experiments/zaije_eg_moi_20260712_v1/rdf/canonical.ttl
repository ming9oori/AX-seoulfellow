res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1226 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1226_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이 호텔은 트럭 운전사가 이용하지 않는 레스토랑, 화려한 로비, 룸 서비스, 책상 등을 모두 줄이거나 없애는 대신에 침구와 목욕탕의 품질을 한 단계 높이면서 가격은 30% 이상 줄였다." ;
    eg:excel_row 1226 ;
    eg:label "Excel row 1226" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
