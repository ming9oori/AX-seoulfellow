res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1296 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1296_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "전략 개발 평가 기준 두 가지는 ① 고객에게 중요한가(Importance)와 ②경쟁사와 차별화되는 특징인가(Difference)임을 명심하라." ;
    eg:excel_row 1296 ;
    eg:label "Excel row 1296" ;
    eg:page "170.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "3ea5796f09ea51c5a4b3f4bc37ae4649fbf8d92d7249494ecf6489dd8fb9210c" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1296" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1297 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1297_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "만약 고객에게 중요하지도 않고, 경쟁사도 가지고 있는 솔루션만을 제시한다면 결코 제안에서 성공할 수 없다." ;
    eg:excel_row 1297 ;
    eg:label "Excel row 1297" ;
    eg:page "170.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
