res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1190 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1190_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "예를 들면 탐색연구는 100억 원이지만 이 기술을 통해서 생산하는 무기체계가 1조 원 사업이라고 한다면 업체들은 300억, 400억 원을 써 가면서 100억 원짜리 사업을 수주하려고 한다." ;
    eg:excel_row 1190 ;
    eg:label "Excel row 1190" ;
    eg:page "159.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
