    eg:text_sha256 "5e1bd7a30d2416374d9ab8fd2e8f10483210f07a7e75af70106426178270906b" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-812" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-813 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-813_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "두 번째, 대부분의 공공, 금융 대형 발주 사업에서 실제 평가시간은 너무 짧고, 평가위원은 주로 대학교수이기 때문에 해당 사업에 대해서는 자신의 전공분야와 관련하여 부분적으로만 알고 있거나 전혀 모르는 경우가 태반이다." ;
    eg:excel_row 813 ;
    eg:label "Excel row 813" ;
    eg:page "123.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "a41474a452b3a2b0e4372bdd95a8774fc41437eef6123b0ce7167cd892dded6e" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-813" .

