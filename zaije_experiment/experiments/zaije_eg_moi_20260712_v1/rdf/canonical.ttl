res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-84 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-84_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "실제로 9시에 서울이나 대전에 있는 조달청에 도착한 평가위원들은 수백 페이지에 이르는 3~5개 기업(모두 합치면 수천 페이지)의 기술적이고 전문적인 문서를 불과 2~3시간에 읽고 평가를 마쳐야 한다." ;
    eg:excel_row 84 ;
    eg:label "Excel row 84" ;
    eg:page "27.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
