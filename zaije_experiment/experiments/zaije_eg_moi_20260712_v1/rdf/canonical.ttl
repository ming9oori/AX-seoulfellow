res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-44 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-44_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이를 간파한 경영진은 대부분의 구매결정 프로세스를 투명화하여 비용을 낮추는 방법으로 공식화된 경쟁입찰 프로세스를 운영하고 있다." ;
    eg:excel_row 44 ;
    eg:label "Excel row 44" ;
    eg:page "24.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
