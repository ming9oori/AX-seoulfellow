res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1228 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1228_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "또는 부가적 기능을 더 하라–제지시장의 고객에게 경영컨설팅 제공도저히 솔루션의 가치를 차별화할 수 없는 제품(통상 이를 ‘저관여 제품’이라고 부른다)은 어떻게 차별화가 가능한가?" ;
    eg:excel_row 1228 ;
    eg:label "Excel row 1228" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
