    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-790_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그리고 사실 와이프보다 더 중요한 것은 자기 스스로를 설득하는 거야." ;
