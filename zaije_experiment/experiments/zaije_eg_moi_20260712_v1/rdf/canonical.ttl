res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-751 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-751_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "문제는 한 번 옳지 않은 방법에 익숙해지면 그것을 극복하기란 거의 불가능하다는 점이다." ;
    eg:excel_row 751 ;
