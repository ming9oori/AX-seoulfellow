    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "1338bd944840fd5598c718b36f9650fc70279fbf2a01863ffc94b4958d8060bf" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-796" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-797 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-797_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "수주영업을 할 때도 반드시 명심해야 할 점은 고객의 구매 니즈나 의사결정이 항상 합리적인 토론과 추론에 따라 결정된다고 생각하면 안 된다." ;
    eg:excel_row 797 ;
    eg:label "Excel row 797" ;
    eg:page "118.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
