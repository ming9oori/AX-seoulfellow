    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-924" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-925 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-925_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "예를 들어보자." ;
    eg:excel_row 925 ;
    eg:label "Excel row 925" ;
