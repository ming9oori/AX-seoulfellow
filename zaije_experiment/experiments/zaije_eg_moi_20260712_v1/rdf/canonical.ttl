res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1116 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1116_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "또 하나의 효과는 이렇게 자신의 약점을 밝혀버리자 더는 경쟁자의 공략이 날카롭게 느껴지지 않더라는 점이다." ;
    eg:excel_row 1116 ;
    eg:label "Excel row 1116" ;
    eg:page "152.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
