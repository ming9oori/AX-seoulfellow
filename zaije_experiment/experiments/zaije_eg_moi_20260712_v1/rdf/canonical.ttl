    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "리스크 관리 전략 중에서 가장 흔하게 저지르는 실수는 리스크를 언급하는 것 자체를 피하는 일이다." ;
    eg:excel_row 1317 ;
    eg:label "Excel row 1317" ;
    eg:page "173.0" ;
