    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1283" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1284 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1284_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "제시하는 데이터가 설명력이 떨어질 때도 많고, 실제 수행업체로 선정되었을 경우 제시한 데이터가 계약서에 준한 효력을 발휘하여 자신들의 발목을 잡기 때문이다." ;
    eg:excel_row 1284 ;
    eg:label "Excel row 1284" ;
    eg:page "169.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "174c03c5a807af7ae118664764e8a1dd1eb490a3e8029fcf69fd116e82786567" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1284" .

