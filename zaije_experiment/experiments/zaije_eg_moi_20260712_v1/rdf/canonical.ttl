    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1055" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1056 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1056_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "한편으로 제안서를 작성하는 수행 조직은 제안서 수가 기존의 50~60%로 줄어들어 좀더 품질높은 제안서를 작성할 수 있게 되었다." ;
    eg:excel_row 1056 ;
    eg:label "Excel row 1056" ;
    eg:page "145.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
