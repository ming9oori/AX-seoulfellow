    eg:evidence_anchor_ids "[\"egmoi:evidence/xlsx-row-78_A01\"]"^^rdf:JSON ;
    eg:evidence_id "egmoi:evidence/xlsx-row-78" ;
    eg:exact_text "우리나라의 조달사업한국의 공공 조달사업 특징은 ‘낮은 평가 수준, 높은 투명성’으로 요약할 수 있다." ;
    eg:label "우리나라의 조달사업한국의 공공 조달사업 특징은 ‘낮은 평가 수준, 높은 투명성’으로 요약할 수 있다." ;
    eg:start_char 0 ;
    eg:status "VALIDATED" ;
    eg:structure_type "PROSE_CLAUSE" ;
