    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1116" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1117 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1117_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "Shipley Tip전략기술서“우리는 ①단순성, 무게 경량화, 뒤끌림 감소 등과 ②지상에서 조작의 용이성을 논의함으로써 세발기어 대비 우리 Tail-skid 착륙장치의 약점을 최소화할 것이다.”" ;
    eg:excel_row 1117 ;
    eg:label "Excel row 1117" ;
    eg:page "152.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "8630603016f65a32c83419bda5075dfdf1f4288a993b7eb101b97f87be45b935" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1117" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1119 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1119_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "경쟁사의 약점을 교묘하게 강조하라." ;
    eg:excel_row 1119 ;
    eg:label "Excel row 1119" ;
    eg:page "153.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
