    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1297" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1298 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1298_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
