res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-972 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-972_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "두 번째 목적은 핵심 이슈 분석을 통해 핵심 차별화요소(Discriminator)를 찾아내고 이를 중심으로 전략을 수립하기 위해서이다." ;
    eg:excel_row 972 ;
    eg:label "Excel row 972" ;
    eg:page "137.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "33e2eee4c315f02c8d4428981e2a61e51008807949814335c5cfe71f42452c0c" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-972" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-973 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-973_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "여기에서 중요한 것은 핵심 차별화요소는 객관적 사실이라기보다는 고객의 인식(Recognition)이라는 점이다." ;
    eg:excel_row 973 ;
    eg:label "Excel row 973" ;
    eg:page "137.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "316cc0f49c5fd60728f3f2112f580d4bb562be27617cd87e013fbca926215d4f" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-973" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-974 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-974_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "핵심 차별화요소란 고객이 중요하게 생각하는 핵심 이슈의 솔루션을 자사(혹은 경쟁사)만 가지고 있어서 차별화 포인트가 되는 요소를 말한다." ;
    eg:excel_row 974 ;
    eg:label "Excel row 974" ;
    eg:page "137.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "809af0fc7d62f10d2212f22fbc9f0635f5e08f4630bd084a670b5ca21fb1110e" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-974" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-975 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-975_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "핵심 차별화요소는 경쟁자에게도 있다는 점을 명심해야 한다." ;
    eg:excel_row 975 ;
    eg:label "Excel row 975" ;
    eg:page "137.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
