    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "정공법과 역공법 중 어떤 방법을 선택할 것인가는 고객의 이슈를 얼마나 정확히 이해했는가에 달려 있다." ;
    eg:excel_row 1311 ;
    eg:label "Excel row 1311" ;
    eg:page "172.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
