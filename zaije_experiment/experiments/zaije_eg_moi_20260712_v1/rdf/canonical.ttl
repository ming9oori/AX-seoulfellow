    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-435" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-436 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-436_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "친하지도 않고, 심지어 기분도 살짝 나쁘지만 어쩔 수 없이 평소에 약의 효능을 잘 설명해 주고, 학습량이 많은 이 사람을 찾을 수밖에 없는 일이다." ;
    eg:excel_row 436 ;
    eg:label "Excel row 436" ;
    eg:page "70.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "adf0e6a533e978c0f29ee1002e5850fd0c43df110ba7169513ad77067d448a73" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-436" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-437 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-437_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
