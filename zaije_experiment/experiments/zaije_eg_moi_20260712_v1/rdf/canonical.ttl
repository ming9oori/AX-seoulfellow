    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "왜 이 단계에서 참여결정(Bid Decision)의 타당성을 또 결정해야 하는가?" ;
    eg:excel_row 225 ;
    eg:label "Excel row 225" ;
