res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-328 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-328_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "세일즈는 상품이나 서비스에 대한 세일즈맨 개인의 지식을 기초로 판매가 일어나지만 B/D는 판매 조직의 역량을 기반으로 판매가 일어난다." ;
    eg:excel_row 328 ;
    eg:label "Excel row 328" ;
    eg:page "62.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
