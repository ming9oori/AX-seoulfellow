    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-645" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-647 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-647_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "대체로 위 두 단계를 통해서 고객은 적절한 솔루션이 무엇인지를 결정한다." ;
    eg:excel_row 647 ;
    eg:label "Excel row 647" ;
    eg:page "107.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
