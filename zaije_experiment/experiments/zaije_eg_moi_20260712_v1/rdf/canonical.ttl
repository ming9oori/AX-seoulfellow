res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-93 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-93_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "우리가 선진국 사회에 진입하기 위해서는 국가행정과 기업경영이 한 단계 진일보한 투명성을 갖추어 저비용, 고효율의 사회를 구현해야 한다." ;
    eg:excel_row 93 ;
    eg:label "Excel row 93" ;
    eg:page "28.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
