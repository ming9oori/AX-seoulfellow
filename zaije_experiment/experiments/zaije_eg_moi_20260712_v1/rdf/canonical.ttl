    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "A 제지회사의 고민은 제지시장이 워낙 원자재에 가까운 시장이다 보니 가격과 솔루션에서 차별화하기가 둘 다 거의 불가능하다는 것이다." ;
    eg:excel_row 1231 ;
    eg:label "Excel row 1231" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
