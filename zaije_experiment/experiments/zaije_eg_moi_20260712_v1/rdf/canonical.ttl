    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "고객의 가치 관점에서 솔루션을 재구성한 결과 가격은 낮추고, 서비스의 만족도는 높이는 일거양득 전략을 구사할 수 있게 되었다." ;
    eg:excel_row 1227 ;
    eg:label "Excel row 1227" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
