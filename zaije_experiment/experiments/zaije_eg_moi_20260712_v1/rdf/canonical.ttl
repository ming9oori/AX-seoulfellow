    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-221_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이 제안서 기획은 전략 개발 및 리뷰와 섹션기획서 작성 및 리뷰까지를 포함한다." ;
