    eg:text_sha256 "ce7555e49c536e12f3add537af330e79aeab5405be0408a27a5db95fe9cb00ca" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-131" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1310 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1310_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "어떤 차를 구매하느냐는 고객에 따라 다르겠지만 디자인이나 가격보다 안전이 더 중요한 중대형 승용차 구매고객의 특성을 고려하면, 가격경쟁력이나 디자인의 열세를 대신하여 안전성을 홍보하는 위의 사례는 제법 설득력 있는 접근방법임을 알 수 있다." ;
    eg:excel_row 1310 ;
    eg:label "Excel row 1310" ;
    eg:page "172.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "bb2348fc46e6976ccc9b843ea53abb977dce7f6f2f3ab44b4e7a8936f53e9121" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1310" .

