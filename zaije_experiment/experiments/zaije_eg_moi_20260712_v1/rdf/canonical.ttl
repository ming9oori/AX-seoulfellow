res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1293 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1293_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "고객의 관심을 포괄하여 전략적으로 다루고, 그중 고객이 중요하게 생각하는 몇 가지 포인트에서는 고객을 설득할 수 있는 결정적 승부수를 던지라." ;
    eg:excel_row 1293 ;
    eg:label "Excel row 1293" ;
    eg:page "170.0" ;
