    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "대부분의 원자재, 단품 세일즈를 하는 사람에게는 ‘솔루션’이라는 말은 추상적인 말일 수밖에 없는 비현실적인 단어에 불과한 것이다." ;
    eg:excel_row 1229 ;
    eg:label "Excel row 1229" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
