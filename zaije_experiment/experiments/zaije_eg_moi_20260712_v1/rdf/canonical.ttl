res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-645 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-645_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-645_A02 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이때에는 우리 솔루션의 효용이 대체제를 포함한 다른 솔루션의 효용보다 크다는 점을 고객이 인식하게 해야 하며, 이것이 수주영업의 목적이다." ;
    eg:excel_row 645 ;
    eg:label "Excel row 645" ;
    eg:page "106.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
