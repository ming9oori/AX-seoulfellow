    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "또한 경쟁사비교표를 작성하기 위해서 더 많은 정보를 수집해야 했기에 당연히 영업의 품질은 좋아졌다." ;
    eg:excel_row 1055 ;
    eg:label "Excel row 1055" ;
    eg:page "145.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
