res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1076 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1076_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1076_A02 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "우리가 앞 단계(고객 니즈 발굴, 경쟁사 비교 및 핵심 차별화요소 정의)까지는 정보에 기반을 둔 논리적이고, 분석적인 접근이 필요했다면 이 단계에서는 경쟁자를 압도하는 좋은 아이디어를 개발해야 한다." ;
    eg:excel_row 1076 ;
    eg:label "Excel row 1076" ;
    eg:page "149.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
