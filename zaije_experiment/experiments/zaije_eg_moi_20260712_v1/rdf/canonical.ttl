res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-216 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-216_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "첫 번째는 제안참여 의사결정(Bid/No Bid Decision) 프로세스가 있고, 두 번째는 제안서 작성을 위한 프로세스가 있다." ;
    eg:excel_row 216 ;
    eg:label "Excel row 216" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
