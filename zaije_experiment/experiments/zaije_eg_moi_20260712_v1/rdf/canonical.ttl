    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이럴 때는 솔루션의 본질적인 가치와는 상관이 없지만 고객에게 효용을 줄 수 있는 부가적인 기능을 개발하라는 것이다." ;
    eg:excel_row 1230 ;
    eg:label "Excel row 1230" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
