    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "4f9e3be6fd56cc50a506f7799ada80dad943a1e66481b3d81738171daf80c988" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-438" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-439 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-439_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "“그렇구나, ABS가 성행할수록 SBS(Solution Based Selling, 전문가 영업) 를 해야 차별화가 쉽겠구나!”" ;
    eg:excel_row 439 ;
