    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1056" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1057 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1057_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "결론적으로 이 조직은 제안 참여 횟수를 줄이고(선택), 참여하는 사업에 영업과 제안서의 품질을 높임(집중)으로써 30%대 수주율을 70%대까지 올리게 되었다." ;
    eg:excel_row 1057 ;
    eg:label "Excel row 1057" ;
    eg:page "145.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
