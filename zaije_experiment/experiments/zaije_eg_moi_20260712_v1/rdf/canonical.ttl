    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1290" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1291 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1291_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1291_A02 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이럴 때에는 우선적으로 고객의 모든 이슈를 포괄하고, 몇 가지 이슈에서 승부수(Winning Strategy)를 띄우는 방법을 사용하여야 한다." ;
    eg:excel_row 1291 ;
    eg:label "Excel row 1291" ;
