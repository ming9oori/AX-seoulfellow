    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "아까 그 사람은 가죽 냄새를 맡으면서 구매 결정을 하고, 이를 설명하기 위한 수십 가지 이유를 이미 찾았을 거야." ;
    eg:excel_row 788 ;
    eg:label "Excel row 788" ;
    eg:page "117.0" ;
