    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-222" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-223 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-223_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이 단계에서 수주전략(Capture Strategy)은 제안전략(Proposal Strategy)으로 발전한다." ;
