res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-222 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-222_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "제안서 기획(Proposal Planning)은 처음부터 하는 것이 아니라 작성된 영업정보(Capture Plan)를 기반으로 제안서 작성과 관련된 일정 및 역할분담 등이 추가된다." ;
    eg:excel_row 222 ;
    eg:label "Excel row 222" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
