    eg:text_sha256 "4d489629783dafa8093e32da25b89ee1e1be80281084cd1c952f16ed437d8a13" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-217" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-218 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-218_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "먼저 기회분석(Opportunity Assessment)이 끝나고 나면 고객과 경쟁자 정보수집을 위한 영업활동(Capture Planning, 이하 수주영업)을 할 것인가 말 것인가를 결정하는 것이 영업참여 결정(Pursuit Decision)이다." ;
    eg:excel_row 218 ;
    eg:label "Excel row 218" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "0ba1fea7f49f95f87cd0d4d006fea05689b3e320e2873fce858749a6c44b6203" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-218" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-219 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-219_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "정보수집을 위한 영업활동이 끝나면 이 축적된 정보를 기반으로 제안참여 의사결정(Bid/ No Bid Decision)을 하게 된다." ;
    eg:excel_row 219 ;
    eg:label "Excel row 219" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "9024e38a920d2a3a8135f4d74217dc879ea0668fc5a3d0fb04bec6a16037661c" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-219" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-22 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-22_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "오히려 제안 요청서가 발행되면 고객에게 미치는 판매자의 영향력은 극히 제한된다." ;
    eg:excel_row 22 ;
    eg:label "Excel row 22" ;
    eg:page "22.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
    eg:systemId "EG-MOI-V1" ;
    eg:text_sha256 "0604380fb8b8ea60acaaa41d133c2df83fa03e3b01df42c2b4a3e1f82595f70f" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-22" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-220 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-220_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "제안에 참여하기로 하면 그 시점부터 제안서 기획(Proposal Planning)을 한다." ;
    eg:excel_row 220 ;
    eg:label "Excel row 220" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
