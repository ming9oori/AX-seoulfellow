    eg:text_sha256 "285fb4f1e698232020f9486f4afc603aee3cd2a8695e9e598de6120a0a43111e" ;
    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-643" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-644 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-644_A01 ;
