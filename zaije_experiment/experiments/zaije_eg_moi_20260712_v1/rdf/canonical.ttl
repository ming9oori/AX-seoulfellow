    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "고객에게 설득력이 높은 제안은 논리적으로 설득적일(Logically Persuasive) 뿐만 아니라 감성적으로 신뢰를 확보(Emotionally Credible)하는 것을 말한다." ;
    eg:excel_row 760 ;
    eg:label "Excel row 760" ;
    eg:page "116.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
