    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-928" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-929 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-929_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "특히 외부 영향자의 영향력은 매우 중요하다." ;
    eg:excel_row 929 ;
    eg:label "Excel row 929" ;
