    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-1298" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1299 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1299_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1299_A02 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "정공법은 경쟁자가 제기한 이슈에 정면 대결을 하는 것이고, 역공법은 우리가 제기한 이슈가 경쟁자가 제기한 이슈보다 더 중요하다는 것을 설득하는 것을 말한다." ;
    eg:excel_row 1299 ;
    eg:label "Excel row 1299" ;
    eg:page "171.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
