    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "이를테면 이번 프로젝트에서 고객의 절대적인 관심이 ‘납기 준수’라면 아무리 가격이나 품질에 장점이 있더라도 ‘납기 준수’라는 이슈를 피해서는 이길 수 없다." ;
    eg:excel_row 1312 ;
    eg:label "Excel row 1312" ;
    eg:page "172.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
