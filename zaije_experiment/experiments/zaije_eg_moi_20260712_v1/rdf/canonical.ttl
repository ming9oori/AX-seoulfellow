    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "만약에 고객조직의 평가자에게 미치는 영향력이 전혀 없다면 그 조직을 분석하지 말고, 평가위원회를 분석하라." ;
    eg:excel_row 946 ;
    eg:label "Excel row 946" ;
    eg:page "135.0" ;
