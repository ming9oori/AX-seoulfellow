res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-129 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-129_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "최근 기업이 법률·회계 자문 및 컨설팅 업체를 선정하는 방식이 변하고 있다." ;
