    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-226" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-227 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-227_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "RFP는 경쟁자와 나의 영업 산물이기도 하다." ;
    eg:excel_row 227 ;
    eg:label "Excel row 227" ;
    eg:page "44.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
