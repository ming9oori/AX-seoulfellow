    eg:uid "EG-MOI-V1::egmoi:evidence/xlsx-row-129" .

res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1290 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1290_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그런데 자신의 포지션이 불명확하고 경쟁자의 전략을 예측하기가 불가능한 경우도 많다." ;
