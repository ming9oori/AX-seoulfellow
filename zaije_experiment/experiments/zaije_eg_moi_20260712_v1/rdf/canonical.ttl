res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-123 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-123_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "불과 몇 년 전까지만 해도 입찰 제안서 작성과 제안 프레젠테이션이 중요한 산업은 시스템통합(SI) 업체와 플랜트, 방위산업 정도에 한정되어 있었다." ;
    eg:excel_row 123 ;
    eg:label "Excel row 123" ;
    eg:page "30.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
    eg:status "VALIDATED" ;
