res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1092 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1092_A01,
        res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1092_A02,
