    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그러나 수주영업에서는 ‘관계구축’이 전부가 아니라 관계구축을 통해 ‘고객과 경쟁자 정보’를 수집하여 전략적으로 세일즈하는 것이 중요하다." ;
    eg:excel_row 151 ;
    eg:label "Excel row 151" ;
    eg:page "36.0" ;
