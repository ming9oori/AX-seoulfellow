res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1225 a eg:EvidenceUnit ;
    eg:HAS_ANCHOR res:EG-MOI-V1%3A%3Aegmoi%3Aevidence%2Fxlsx-row-1225_A01 ;
    eg:evidence_anchor_ids "[]"^^rdf:JSON ;
    eg:exact_text "그래서 이들을 위한 초저가 호텔을 만들었다." ;
    eg:excel_row 1225 ;
    eg:label "Excel row 1225" ;
    eg:page "162.0" ;
    eg:source_binary_sha256 "e8c5f174b65eccd7a50dbd2e0e216ea870a6aedfd16b3e4538d6486aea15cf1f" ;
