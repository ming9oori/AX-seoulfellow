    zaije:uid "SIMPLE-E2E::zaije:evidence/xlsx-row-488_X10" .

res:SIMPLE-E2E%3A%3Azaije%3Aevidence%2Fxlsx-row-488_X12 a zaije:ContextSpan ;
    zaije:label "(근거) 빅 4와 같은 기본적 유대 관계나 아웃소싱㈜과 같은 명성은 없다. 이전부터<br>영업을 꾸준히 해 온 것도 아님. 하지만 미팅을 통해 담당자는 비교적 상세한 정보를<br>우리에게 제공해 주었고 상황이 그리 나쁜 것만은 아님." ;
    zaije:systemId "SIMPLE-E2E" ;
    zaije:uid "SIMPLE-E2E::zaije:evidence/xlsx-row-488_X12" .

res:SIMPLE-E2E%3A%3Azaije%3Aevidence%2Fxlsx-row-488_X14 a zaije:ContextSpan ;
