// Generated by scripts/build_ax_zaije_layer2_kg.py
// Copy nodes.csv and edges.csv into Neo4j import directory, then run in Neo4j Browser/cypher-shell.

CREATE CONSTRAINT ax_l2_node_id IF NOT EXISTS FOR (n:L2Node) REQUIRE n.id IS UNIQUE;

LOAD CSV WITH HEADERS FROM 'file:///nodes.csv' AS row
MERGE (n:L2Node {id: row.id})
SET n.node_type = row.node_type,
    n.name_ko = row.name_ko,
    n.name_en = row.name_en,
    n.definition = row.definition,
    n.source_book_id = row.source_book_id,
    n.evidence_refs_json = row.evidence_refs_json,
    n.confidence = CASE row.confidence WHEN '' THEN null ELSE toFloat(row.confidence) END,
    n.review_status = row.review_status,
    n.schema_version = row.schema_version,
    n.raw_json = row.raw_json
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'AliasTerm' THEN [1] ELSE [] END | SET n:AliasTerm)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Artifact' THEN [1] ELSE [] END | SET n:Artifact)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Book' THEN [1] ELSE [] END | SET n:Book)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Chapter' THEN [1] ELSE [] END | SET n:Chapter)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'DecisionOutcome' THEN [1] ELSE [] END | SET n:DecisionOutcome)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'DecisionPoint' THEN [1] ELSE [] END | SET n:DecisionPoint)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'DomainOntology' THEN [1] ELSE [] END | SET n:DomainOntology)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'DomainProcess' THEN [1] ELSE [] END | SET n:DomainProcess)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'DomainTask' THEN [1] ELSE [] END | SET n:DomainTask)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'EvidenceSpan' THEN [1] ELSE [] END | SET n:EvidenceSpan)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'InformationObject' THEN [1] ELSE [] END | SET n:InformationObject)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Metric' THEN [1] ELSE [] END | SET n:Metric)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Principle' THEN [1] ELSE [] END | SET n:Principle)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'ReviewType' THEN [1] ELSE [] END | SET n:ReviewType)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Risk' THEN [1] ELSE [] END | SET n:Risk)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Role' THEN [1] ELSE [] END | SET n:Role)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Section' THEN [1] ELSE [] END | SET n:Section)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'SourceChunk' THEN [1] ELSE [] END | SET n:SourceChunk)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'Stakeholder' THEN [1] ELSE [] END | SET n:Stakeholder)
FOREACH (_ IN CASE WHEN row.labels CONTAINS 'StrategyPattern' THEN [1] ELSE [] END | SET n:StrategyPattern)
;

LOAD CSV WITH HEADERS FROM 'file:///edges.csv' AS row
WITH row WHERE row.predicate = 'ALIAS_OF'
MATCH (s:L2Node {id: row.source_id})
MATCH (t:L2Node {id: row.target_id})
MERGE (s)-[r:ALIAS_OF {edge_id: row.edge_id}]->(t)
SET r.predicate = row.predicate,
    r.evidence_refs_json = row.evidence_refs_json,
    r.confidence = CASE row.confidence WHEN '' THEN null ELSE toFloat(row.confidence) END,
    r.relation_scope = row.relation_scope,
    r.extraction_run_id = row.extraction_run_id,
    r.review_status = row.review_status,
    r.validation_status = row.validation_status,
    r.raw_json = row.raw_json;

